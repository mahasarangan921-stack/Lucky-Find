# --- Server ---
PORT=5001

# --- Database ---
MONGO_URI=mongodb://localhost:27017/lottery
MONGO_TIMEOUT_MS=5000

# --- Scraper ---
# Official Kerala Lottery source site
LOTTERY_SOURCE_URL=https://www.keralalotteries.net/
# Max number of result pages to follow from the homepage
RESULT_PAGE_LIMIT=30
# How long the in-memory cache is considered fresh (ms)
RESULT_CACHE_TTL_MS=900000
# Axios timeout for source requests (ms)
SOURCE_TIMEOUT_MS=15000

# --- CORS ---
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
# Set to "debug" (or DEBUG=true) to enable verbose debug logs
LOG_LEVEL=info
DEBUG=false
